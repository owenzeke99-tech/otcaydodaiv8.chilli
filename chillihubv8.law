local CorrectKey = "ChilliHubV8KwyaiajjwwkowowLalqowkkenebLapqowijendo"
local KeyFileName = "ChilliHub_V8_Key.txt"
local KeyDuration = 86400 -- 24 giờ tính bằng giây

-- Hàm kiểm tra Key đã lưu từ File hoặc Bộ nhớ
local function GetSavedKey()
    -- 1. Kiểm tra qua getgenv trước cho nhanh
    local env = (getgenv and getgenv()) or _G
    if env.ChilliHubKey and env.ChilliHubTime and (os.time() - env.ChilliHubTime < KeyDuration) then
        if env.ChilliHubKey == CorrectKey then
            return CorrectKey
        end
    end

    -- 2. Kiểm tra qua File nếu Executor hỗ trợ
    if isfile and readfile then
        local success, content = pcall(function()
            if isfile(KeyFileName) then
                return readfile(KeyFileName)
            end
        end)
        if success and content then
            local sep = content:find("|")
            if sep then
                local savedKey = content:sub(1, sep - 1)
                local savedTime = tonumber(content:sub(sep + 1))
                if savedKey == CorrectKey and savedTime and (os.time() - savedTime < KeyDuration) then
                    -- Đồng bộ ngược lại vào getgenv
                    env.ChilliHubKey = savedKey
                    env.ChilliHubTime = savedTime
                    return CorrectKey
                end
            elseif content == CorrectKey then
                return CorrectKey
            end
        end
    end
    
    return nil
end

-- Hàm lưu Key (Lưu cả vào File và Bộ nhớ)
local function SaveKey(key)
    local env = (getgenv and getgenv()) or _G
    local currentTime = os.time()
    
    env.ChilliHubKey = key
    env.ChilliHubTime = currentTime

    pcall(function()
        if writefile then
            local data = key .. "|" .. tostring(currentTime)
            writefile(KeyFileName, data)
        end
    end)
end

-- Nếu đã có key hợp lệ, load thẳng script chính không hiện menu
if GetSavedKey() == CorrectKey then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/napun87/stealanegg/refs/heads/main/chilli.otcaydodaiNoKey3.7.lua"))()
    return
end

