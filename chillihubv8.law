-- Input Focus Animation
KeyInput.Focused:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(255, 70, 70)}):Play()
end)

KeyInput.FocusLost:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(90, 30, 35)}):Play()
end)

local function ShakeUI()
    local startPos = UDim2.new(0.5, -180, 0.5, -125)
    local tweenInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true)
    
    for i = 1, 3 do
        local offset = (i % 2 == 0) and 7 or -7
        local tween = TweenService:Create(MainFrame, tweenInfo, {Position = startPos + UDim2.new(0, offset, 0, 0)})
        tween:Play()
        tween.Completed:Wait()
    end
    MainFrame.Position = startPos
end

local function ShowNotification(text, isSuccess)
    local targetColor = isSuccess and Color3.fromRGB(30, 200, 100) or Color3.fromRGB(255, 60, 60)
    local targetBg = isSuccess and Color3.fromRGB(15, 35, 20) or Color3.fromRGB(40, 15, 18)
    
    NotificationCard.BackgroundColor3 = targetBg
    StatusLabel.TextColor3 = targetColor
    StatusLabel.Text = text
    
    TweenService:Create(NotificationCard, TweenInfo.new(0.25), {BackgroundTransparency = 0.2}):Play()
    TweenService:Create(CardStroke, TweenInfo.new(0.25), {Transparency = 0, Color = targetColor}):Play()
    TweenService:Create(StatusLabel, TweenInfo.new(0.25), {TextTransparency = 0}):Play()
end

GetKeyBtn.MouseButton1Click:Connect(function()
    local keyLink = "https://link4m.org/sfkrDJo"
    if setclipboard then
        setclipboard(keyLink)
        ShowNotification("Key link copied to clipboard!", true)
    else
        ShowNotification("Failed to copy link automatically.", false)
    end
    
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.1}):Play()
    task.wait(0.15)
    TweenService:Create(GetKeyBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.35}):Play()
end)

SubmitBtn.MouseButton1Click:Connect(function()
    local input = KeyInput.Text
    if input == CorrectKey then
        ShowNotification("Access Granted! Loading Script...", true)
        SaveKey(input)
        
        TweenService:Create(SubmitBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.1, BackgroundColor3 = Color3.fromRGB(40, 180, 80)}):Play()
        task.wait(0.8)
        
        ScreenGui:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/napun87/stealanegg/refs/heads/main/chilli.otcaydodaiNoKey3.7.lua"))()
    else
        ShowNotification("Invalid Key! Please try again.", false)
        KeyInput.Text = ""
        ShakeUI()
    end
    
    TweenService:Create(SubmitBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.1}):Play()
    task.wait(0.15)
    TweenService:Create(SubmitBtn, TweenInfo.new(0.15), {BackgroundTransparency = 0.35}):Play()
end)
